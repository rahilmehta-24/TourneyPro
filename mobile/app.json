{
  "expo": {
    "name": "Baseline Society",
    "slug": "baseline-society",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2B20"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baselinesociety.app"
    },
    "android": {
      "package": "com.baselinesociety.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2B20"
      }
    },
    "scheme": "baselinesociety",
    "plugins": [
      "expo-asset"
    ]
  }
}
