# TourneyPro — UAT Environment Configuration Template
# Copy this file to .env.uat or use these values in your Vercel UAT Project and GitHub Secrets

# Flask Core
SECRET_KEY=uat-change-me-to-a-secure-random-32-byte-hex-string
FLASK_APP=run.py
FLASK_ENV=production

# Superadmin Bootstrapping Credentials (Created on first run)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-to-secure-password

# Supabase UAT Database Connection URI (PgBouncer Transaction Pooler on port 6543)
# Replace <uat_project_ref> and <your_db_password> with values from your Supabase UAT project
DATABASE_URL=postgresql://postgres.<uat_project_ref>:<your_db_password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# GitHub Actions Secret Name for UAT migrations:
# Set secret `UAT_DATABASE_URL` in GitHub Repository Settings -> Secrets and variables -> Actions
